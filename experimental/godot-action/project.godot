; 相剋のビルドサーガ ACTION - Godot 4 プロジェクト
; Godot 4.3 以降で開けます。初回は必ずエディタで開いてください（PNGのインポートが走ります）。

config_version=5

[application]

config/name="相剋のビルドサーガ ACTION"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameData="*res://scripts/game_data.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.047, 0.051, 0.078, 1)
